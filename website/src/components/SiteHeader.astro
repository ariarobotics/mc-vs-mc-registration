---
import { sitePath } from "../lib/paths";
---
<header class="site-header">
  <a class="lab-brand" href="https://www.ariarobotics.com/" aria-label="ARIA Lab at Colorado School of Mines">
    <img src={sitePath("aria-logo.png")} width="29" height="29" alt="" />
    <span class="lab-name">ARIA LAB</span>
    <span class="lab-affiliation">Colorado School of Mines</span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="#abstract">Abstract</a>
    <a href="#results">Results</a>
    <a href="#examples">Examples</a>
  </nav>
</header>

<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 86px; border-bottom: 1px solid var(--line); color: #142c42; }
  .lab-brand { display: inline-flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; }
  .lab-brand img { display: block; flex-shrink: 0; }
  .lab-name { font-size: 14px; font-weight: 750; letter-spacing: .06em; white-space: nowrap; }
  .lab-affiliation { border-left: 1px solid var(--line); padding-left: 12px; font-size: 12px; font-weight: 500; }
  nav { display: flex; flex-shrink: 0; gap: 26px; font-size: 13px; }
  nav a { text-decoration: none; }
  a:hover { color: #ae4a25; }
  a:focus-visible { outline-color: #ae4a25; }
  @media (max-width: 760px) {
    .site-header { align-items: flex-start; flex-direction: column; gap: 14px; padding: 18px 0; }
    nav { gap: 24px; }
  }
</style>
