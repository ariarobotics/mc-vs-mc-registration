---
import { ChartScatter, ChevronDown, Layers, Play, Plus, RotateCcw, SlidersHorizontal, X } from "@lucide/astro";
import { siArxiv, siGithub } from "simple-icons";
const brandIcons = {
    arxiv: siArxiv,
    github: siGithub,
} as const;
const icons = {
    align: Play,
    close: X,
    "chevron-down": ChevronDown,
    examples: ChartScatter,
    feasible: Layers,
    plus: Plus,
    reset: RotateCcw,
    sliders: SlidersHorizontal,
    video: Play,
} as const;
interface Props {
    name: keyof typeof icons | keyof typeof brandIcons;
    size?: number;
    class?: string;
}
const { name, size = 16, class: className } = Astro.props;
const brandIcon = name in brandIcons ? brandIcons[name as keyof typeof brandIcons] : undefined;
const Symbol = name in icons ? icons[name as keyof typeof icons] : undefined;
---
{brandIcon ? (
    <svg viewBox="0 0 24 24" width={size} height={size} class:list={["ui-icon", className]} fill="currentColor" aria-hidden="true" focusable="false"><path d={brandIcon.path} /></svg>
) : Symbol ? (
    <Symbol size={size} class:list={["ui-icon", className]} stroke-width={1.75} fill={name === "video" ? "currentColor" : "none"} aria-hidden="true" focusable="false" />
) : null}
